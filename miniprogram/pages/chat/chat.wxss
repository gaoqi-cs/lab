.chat-page {
  display:flex;
  flex-direction:column;
  height:100vh;
  min-height:0;
  box-sizing:border-box;
  padding:22rpx 30rpx 24rpx;
  background:#F5F7FA;
  }

.chat-tip {
  padding:17rpx 20rpx;
  border-radius:12rpx;
  background:#EEF3F8;
  color:#5F7185;
  font-size:23rpx;
  line-height:1.55;
  }

.suggestion-row {
  display:flex;
  gap:12rpx;
  overflow:hidden;
  margin:18rpx 0 8rpx;
  }

.suggestion-row text {
  padding:12rpx 16rpx;
  border-radius:999rpx;
  background:#EAF1FA;
  color:#2B5B99;
  font-size:22rpx;
  white-space:nowrap;
  }

.message-list {
  flex:1;
  min-height:0;
  }

.message {
  display:flex;
  flex-direction:column;
  max-width:85%;
  margin:20rpx 0;
  }

.message.user {
  margin-left:auto;
  align-items:flex-end;
  }

.message-name {
  margin:0 8rpx 8rpx;
  color:#86909C;
  font-size:21rpx;
  }

.bubble {
  padding:20rpx 22rpx;
  border-radius:14rpx;
  background:#FFF;
  color:#1D2129;
  font-size:27rpx;
  line-height:1.65;
  box-shadow:0 6rpx 16rpx rgba(31,56,88,.05);
  }

.user .bubble {
  background:#2B5B99;
  color:#FFF;
  }

.source-mark {
  display:block;
  margin-top:14rpx;
  padding-top:12rpx;
  border-top:1rpx solid #E7EDF5;
  color:#86909C;
  font-size:20rpx;
  }

.user .source-mark {
  display:none;
  }

.composer {
  display:flex;
  align-items:center;
  gap:14rpx;
  padding-top:16rpx;
  }

.composer input {
  flex:1;
  height:80rpx;
  padding:0 20rpx;
  box-sizing:border-box;
  border-radius:12rpx;
  background:#FFF;
  color:#1D2129;
  font-size:26rpx;
  box-shadow:0 6rpx 16rpx rgba(31,56,88,.05);
  }

.composer button {
  width:108rpx;
  margin:0;
  border-radius:12rpx;
  background:#2B5B99;
  color:#FFF;
  font-size:27rpx;
  font-weight:600;
  }

.composer button[disabled] {
  background:#C8D2DF;
  }

