.inspect-actions,.result-actions {
  display:flex;
  gap:18rpx;
  margin:22rpx 0;
  }

.inspect-actions button,.result-actions button {
  flex:1;
  }

.preview-box {
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:420rpx;
  overflow:hidden;
  border:2rpx dashed #B7C9DD;
  border-radius:16rpx;
  background:#FFF;
  }

.preview-box > image {
  width:100%;
  height:420rpx;
  }

.preview-box > view {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:14rpx;
  color:#4E5969;
  font-size:27rpx;
  }

.preview-box > view image {
  width:78rpx;
  height:78rpx;
  }

.preview-box > view text:last-child {
  color:#86909C;
  font-size:23rpx;
  }

.recognize-btn {
  width:100%;
  }

.result-error {
  margin-top:20rpx;
  }

.result-card {
  margin-top:22rpx;
  padding:26rpx;
  border-radius:16rpx;
  background:#FFF;
  box-shadow:0 8rpx 20rpx rgba(31,56,88,.06);
  }

.result-head,.confidence-row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  }

.result-head text:first-child {
  font-size:29rpx;
  font-weight:700;
  color:#1D2129;
  }

.risk-badge {
  padding:7rpx 14rpx;
  border-radius:999rpx;
  background:#FFF1ED;
  color:#E65C3C;
  font-size:22rpx;
  }

.result-label {
  display:block;
  margin:24rpx 0;
  color:#E65C3C;
  font-size:38rpx;
  font-weight:700;
  }

.confidence-row {
  color:#4E5969;
  font-size:24rpx;
  }

.confidence-row text:last-child {
  color:#2B5B99;
  font-weight:700;
  }

.confidence-track {
  height:12rpx;
  margin:12rpx 0 20rpx;
  overflow:hidden;
  border-radius:999rpx;
  background:#EAF1FA;
  }

.confidence-fill {
  width:68%;
  height:100%;
  border-radius:999rpx;
  background:#2B5B99;
  }

.result-note {
  font-size:23rpx;
  line-height:1.6;
  color:#86909C;
  }

