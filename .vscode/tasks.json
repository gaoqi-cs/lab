{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动实验室安全巡检助手后端",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8001",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/app"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
